            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "album"
                ],
                "summary": "get album details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Album ID",
                        "name": "album_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Album"
                        }
                    }
                }
            }
        },
        "/api/v1/album/{album_id}/track/{track_id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "track"
                ],
                "summary": "get album's track details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Album ID",
                        "name": "album_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Track ID",
                        "name": "track_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Track"
                        }
                    }
                }
            }
        },
        "/api/v1/music/search": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "music"
                ],
                "summary": "get music",
                "parameters": [
                    {
                        "description": "Body",
                        "name": "_",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.FindMusicReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.MusicResult"
                        }
                    }
                }
            }
        },
        "/api/v1/track/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "track"
                ],
                "summary": "get track details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Track ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Track"
                        }
                    }
                }
            }
        }
    },
